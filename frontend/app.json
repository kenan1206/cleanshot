{
  "expo": {
    "name": "CleanU",
    "slug": "cleanu",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": [
      "cleanu",
      "com.googleusercontent.apps.289642101774-vut787knc4vsami25i08u2a219fba80h"
    ],
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "locales": {
      "en": "./src/i18n/locales/en.json",
      "de": "./src/i18n/locales/de.json",
      "tr": "./src/i18n/locales/tr.json",
      "es": "./src/i18n/locales/es.json",
      "fr": "./src/i18n/locales/fr.json",
      "it": "./src/i18n/locales/it.json",
      "pt": "./src/i18n/locales/pt.json",
      "nl": "./src/i18n/locales/nl.json",
      "pl": "./src/i18n/locales/pl.json",
      "ru": "./src/i18n/locales/ru.json"
    },
    "ios": {
      "buildNumber": "1",
      "supportsTablet": true,
      "bundleIdentifier": "com.kenanplayer.cleanu",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Scan and free up space in your photo library",
        "NSPhotoLibraryAddUsageDescription": "Save compressed versions of your photos",
        "NSContactsUsageDescription": "Find duplicate and incomplete contacts",
        "NSFaceIDUsageDescription": "Protect your secret library with Face ID",
        "CFBundleLocalizations": [
          "en",
          "de",
          "tr",
          "es",
          "fr",
          "it",
          "pt",
          "nl",
          "pl",
          "ru"
        ],
        "CFBundleAllowMixedLocalizations": true,
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ],
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.kenanplayer.cleanu",
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_CONTACTS",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2A50D9",
          "resizeMode": "cover"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Scan and free up space in your photo library",
          "savePhotosPermission": "Save compressed versions of your photos",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Find duplicate and incomplete contacts to clean up"
        }
      ],
      "expo-local-authentication",
      "expo-video",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#007AFF"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}